# Supabase public project settings (never put a service-role or secret key here)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only on Vercel. Never prefix an OpenAI secret with VITE_.
OPENAI_API_KEY=
OPENAI_STRETCH_MODEL=gpt-4.1-mini

# Growth Planner works locally without any API key.
# Optional Gemini enhancement: server-only Vercel variables, never VITE_ secrets.
GEMINI_API_KEY=
GEMINI_GROWTH_MODEL=gemini-3.8-flash

# Knowledge Mastery semantic analysis and verification (server only).
# Uses GEMINI_API_KEY above. Optional override of its default model.
GEMINI_MASTERY_MODEL=gemini-2.5-flash
