# Supabase public project settings (never put a service-role or secret key here)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only on Vercel. Never prefix an OpenAI secret with VITE_.
OPENAI_API_KEY=
OPENAI_STRETCH_MODEL=gpt-4.1-mini

# Growth Planner uses authenticated Responses + web search for sourced pathways.
# Optional override; otherwise uses OPENAI_STRETCH_MODEL (or gpt-4.1-mini).
OPENAI_GROWTH_MODEL=gpt-4.1-mini
